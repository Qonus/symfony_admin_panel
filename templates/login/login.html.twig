{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <form method="post">
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="alert !">{{ message }}</div>
        {% endfor %}
        <h1 class="text-2xl">Please Login</h1>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <input autocomplete="off" placeholder="Username" type="text" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
        <input placeholder="Password" type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>a3ca6cb6-3a76-4540-89f1-717cd0aa94fd
            c8c073a7-02d5-49b9-84ed-094315f4f79b
        #}

        <a href={{ path("app_register") }} class="">Create an Account?</a>
        <button class="btn btn-lg btn-primary" type="submit">
            Login
        </button>
    </form>

{% endblock %}
